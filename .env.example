# TEMPLATE — copy to `.env` (gitignored). Setup: docs/setup/local-environment.md
# MediHub backend base URL (no trailing slash), e.g. http://localhost:4000 or https://api.example.com
VITE_MEDIHUB_SERVER=https://your-medihub-backend-url.com

# For local dev proxy (Strict cookies), also copy .env.development.example → .env.development

# CORS: Access-Control-Allow-Origin must match the browser URL exactly (scheme + host + port),
# e.g. http://localhost:3000 for this project's Vite dev server. It cannot be * when using cookies.
# Access-Control-Allow-Credentials: true is required for credentials: "include".

# Optional: if your deployed API uses different paths than the MediHub README defaults,
# uncomment and set (paths must start with /):
# VITE_AUTH_REGISTER_PATH=/api/auth/register
# VITE_AUTH_LOGIN_PATH=/api/auth/login
# VITE_AUTH_LOGOUT_PATH=/api/auth/logout
# VITE_AUTH_REFRESH_PATH=/api/auth/refresh
# VITE_USER_ME_PATH=/api/users/me
# VITE_USER_ME_PHOTO_PATH=/api/users/me/photo
# VITE_USER_ME_PASSWORD_PATH=/api/users/me/password
# VITE_DOCTOR_ME_PATH=/api/doctors/me

# Optional: OAuth start paths (defaults shown). Your backend must expose these routes.
# VITE_AUTH_GOOGLE_PATH=/api/auth/google
# VITE_AUTH_APPLE_PATH=/api/auth/apple
# VITE_AUTH_MICROSOFT_PATH=/api/auth/microsoft

# Where the backend should redirect after OAuth (must match backend allowlist)
# VITE_OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Optional: looping muted hero video on the marketing home page (HTTPS; host your own file for reliability)
# VITE_HERO_VIDEO_URL=https://example.com/medihub-hero-loop.mp4
