# Copy to `.env.production` (gitignored) before `npm run build`, or set these in CI.
# See docs/production/deployment-steps.md

VITE_MEDIHUB_SERVER=https://api.example.com

# Optional — social login callback (must match backend allowlist)
# VITE_OAUTH_REDIRECT_URL=https://app.example.com/auth/callback

# Do NOT set VITE_MEDIHUB_SAME_ORIGIN=true unless you reverse-proxy /api on the app host.
