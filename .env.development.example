# Copy to `.env.development` (gitignored) — loaded only by `npm run dev`.
# See docs/setup/local-environment.md

# Proxy /api and /socket.io to VITE_MEDIHUB_SERVER (fixes Strict HttpOnly cookies on localhost).
# See docs/setup/local-environment.md and vite.config.ts.
VITE_MEDIHUB_SAME_ORIGIN=true

# Required — your MediHub API (e.g. https://your-app.onrender.com), NOT the Vite port:
# VITE_MEDIHUB_SERVER=https://your-app.onrender.com
